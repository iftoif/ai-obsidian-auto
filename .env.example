# ===== AI × Obsidian 第二大脑生态 ======
# 复制为 .env 并填写你的实际值。.env 已被 .gitignore 排除，绝不提交。
# 本文件是所有脚本的唯一配置源：setup-server 生成 systemd 时读取，各脚本运行时 source。
#
# 变量与脚本的对应关系（无需额外映射，脚本直接消费这些名字）：
#   PRIMARY_MAC_IP      → vault-pull / mac-session-pull（SSH 连接主 Mac）
#   SSH_USER    → vault-pull / mac-session-pull（SSH 登录名）
#   MAC_USER            → vault-pull（iCloud 路径 /Users/<MAC_USER>；留空则 = SSH_USER）
#   OBSIDIAN_VAULT_PATH → 所有脚本（服务器 vault 绝对路径）
#   HERMES_HOME         → 蒸馏/索引/自愈（Hermes 数据目录）
#   AI_DISTILL_PROVIDER / AI_DISTILL_MODEL → 蒸馏主模型

# --- 服务器 ---
SERVER_USER=<SERVER_USER>                # 服务器 SSH 用户名（文档/通知用）
SERVER_HOSTNAME=<SERVER_HOSTNAME>        # 服务器主机名（文档/通知用）
OBSIDIAN_VAULT_PATH=$HOME/obsidian       # 服务器上 Vault 的绝对路径
HERMES_HOME=$HOME/.hermes                # Hermes 数据目录（脚本/state 所在）

# --- 主 Mac（服务器主动拉取目标）---
PRIMARY_MAC_IP=<PRIMARY_MAC_IP>          # 主 Mac 局域网 IP（如 192.168.x.x）
SSH_USER=<SSH_USER>      # 主 Mac SSH 登录名（如 your_user）
MAC_USER=<MAC_USER>                      # 主 Mac 本地用户名，iCloud 路径 /Users/<MAC_USER> 用；留空则等于 SSH_USER

# --- 蒸馏 provider（fallback 链用）---
AI_DISTILL_PROVIDER=openai-codex       # 主蒸馏模型 provider（ChatGPT 订阅；也可换 deepseek/kimi 等）
AI_DISTILL_MODEL=gpt-5.6-luna           # 主蒸馏模型名
FALLBACK_PROVIDERS_CSV=                  # 兜底 provider 列表，逗号分隔（如 deepseek,kimi-coding，可选）
FALLBACK_MODELS_CSV=                     # 兜底模型列表，逗号分隔，与上面一一对应（可选）
DEEPSEEK_API_KEY=<your-key>              # 兜底模型1 的 API key（可选）
KIMI_API_KEY=<your-key>                  # 兜底模型2 的 API key（可选）

# --- 备份（可选，rclone 加密网盘）---
RCLONE_REMOTE=crypt_remote:backup/obsidian  # rclone 远程:目录
